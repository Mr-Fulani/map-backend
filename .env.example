# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# PostgreSQL
DATABASE_URL=postgres://map_user:map_password@db:5432/map_db

# Redis
REDIS_URL=redis://redis:6379/0

# Yandex Cloud S3
YC_S3_BUCKET=map-media-prod
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_CDN_DOMAIN=cdn.map.yourdomain.ru

# AI
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Avito OAuth
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Billing (YooKassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Notifications
SITE_URL=https://yourdomain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SENDPULSE_SMTP_LOGIN=
SENDPULSE_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.ru

# Security
FIELD_ENCRYPTION_KEY=        # Fernet key: from cryptography.fernet import Fernet; Fernet.generate_key()
TAVILY_API_KEY=              # Optional fallback provider for grounded web research
WEBHOOK_SIGNING_SECRET=      # HMAC для вебхуков

# Monitoring
SENTRY_DSN=
