# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=map_db
POSTGRES_USER=map_user
POSTGRES_PASSWORD=map_password
DATABASE_URL=postgres://map_user:map_password@db:5432/map_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace-with-a-long-random-production-password

# Yandex Cloud S3
YC_S3_BUCKET=map-media-prod
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_CDN_DOMAIN=cdn.map.yourdomain.ru
MEDIA_KEY_PREFIX=dev

# AI
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Avito OAuth
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Billing (YooKassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Notifications
SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SENDPULSE_SMTP_LOGIN=
SENDPULSE_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.ru

# Security
FIELD_ENCRYPTION_KEY=        # Fernet key: from cryptography.fernet import Fernet; Fernet.generate_key()
# Ротация без простоя: новый primary первым, предыдущие ключи после запятой.
FIELD_ENCRYPTION_KEYS=
TAVILY_API_KEY=              # Optional fallback provider for grounded web research
BRAVE_SEARCH_API_KEY=
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=8

# Retention
SOFT_DELETE_RETENTION_DAYS=90
WEBHOOK_AUDIT_RETENTION_DAYS=180
BILLING_AUDIT_RETENTION_DAYS=730
SYNC_LOG_RETENTION_DAYS=90

# Billing periods
BILLING_TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=7

# Web research
WEB_RESEARCH_AUTO_FALLBACK=true
WEB_RESEARCH_COVERAGE_THRESHOLD=0.65
WEB_RESEARCH_MAX_QUERIES=2
WEB_RESEARCH_RESULTS_PER_QUERY=8

# Monitoring
SENTRY_DSN=
