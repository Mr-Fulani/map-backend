# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=map_db
POSTGRES_USER=map_user
POSTGRES_PASSWORD=map_password
DATABASE_URL=postgres://map_user:map_password@db:5432/map_db

# Redis (локальная разработка: единый fallback)
REDIS_URL=redis://redis:6379/0

# Redis (production: два физических процесса, заполнить все значения)
CACHE_REDIS_PASSWORD=
CELERY_REDIS_PASSWORD=
# Пример после подстановки URL-safe паролей:
# CACHE_REDIS_URL=redis://:cache-secret@redis:6379/0
# CELERY_BROKER_URL=redis://:broker-secret@redis_broker:6379/0
# CELERY_RESULT_BACKEND=redis://:broker-secret@redis_broker:6379/1
# COORDINATION_REDIS_URL=redis://:broker-secret@redis_broker:6379/2
CACHE_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
COORDINATION_REDIS_URL=

# Yandex Cloud S3
YC_S3_BUCKET=map-media-prod
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_CDN_DOMAIN=cdn.map.yourdomain.ru
MEDIA_KEY_PREFIX=dev

# AI
