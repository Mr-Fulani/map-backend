# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.development
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=map_db
POSTGRES_USER=map_user
POSTGRES_PASSWORD=map_password
DATABASE_URL=postgres://map_user:map_password@db:5432/map_db

# Redis (локальная разработка: единый fallback)
REDIS_URL=redis://redis:6379/0

# Redis (production: два физических процесса, заполнить все значения)
CACHE_REDIS_PASSWORD=
CELERY_REDIS_PASSWORD=
# Пример после подстановки URL-safe паролей:
# CACHE_REDIS_URL=redis://:cache-secret@redis:6379/0
# CELERY_BROKER_URL=redis://:broker-secret@redis_broker:6379/0
# CELERY_RESULT_BACKEND=redis://:broker-secret@redis_broker:6379/1
# COORDINATION_REDIS_URL=redis://:broker-secret@redis_broker:6379/2
CACHE_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
COORDINATION_REDIS_URL=

# Yandex Cloud S3
# Для локальной разработки оставьте bucket пустым: Django использует файловое
# хранилище. В production bucket, access key и secret key обязательны.
YC_S3_BUCKET=
YC_S3_ACCESS_KEY=
YC_S3_SECRET_KEY=
YC_CDN_DOMAIN=
MEDIA_KEY_PREFIX=dev

# AI
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Avito OAuth
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Billing (YooKassa). Fail-closed by default; enable only with verified credentials/webhook.
BILLING_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_API_CONNECT_TIMEOUT_SECONDS=3.05
YOOKASSA_API_READ_TIMEOUT_SECONDS=10
YOOKASSA_API_MAX_ELAPSED_SECONDS=30
YOOKASSA_API_MAX_RESPONSE_BYTES=1048576
YOOKASSA_WEBHOOK_PROCESSING_TIMEOUT_SECONDS=120
YOOKASSA_WEBHOOK_RETRY_AFTER_SECONDS=10
YOOKASSA_RECONCILIATION_MAX_ATTEMPTS=48
YOOKASSA_RECONCILIATION_BASE_DELAY_SECONDS=60
YOOKASSA_RECONCILIATION_MAX_DELAY_SECONDS=3600
YOOKASSA_RECONCILIATION_BATCH_SIZE=100
YOOKASSA_ALLOW_TEST_PAYMENTS=false
BILLING_OUTBOX_BASE_DELAY_SECONDS=30
BILLING_OUTBOX_MAX_DELAY_SECONDS=3600
BILLING_OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
BILLING_OUTBOX_BATCH_SIZE=100
BILLING_OUTBOX_MAX_ATTEMPTS=25
BILLING_CHECKOUT_MAX_KEYS_PER_INVOICE=32

# Notifications
SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
BILLING_RETURN_URL_ALLOWED_ORIGINS=https://yourdomain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
RESEND_API_KEY=
# Только системная почта платформы. Tenant sender identities настраиваются отдельно.
DEFAULT_FROM_EMAIL=noreply@notify.dodugir.com
# Production Compose фиксирует этот адрес и не выпускает SMTP напрямую наружу.
EMAIL_HTTP_PROXY_URL=http://egress_proxy:3128

# Security
# Пусто в development: public URL transport сохраняет direct DNS pinning.
# Production Compose принудительно задаёт http://egress_proxy:3128.
PUBLIC_HTTP_PROXY_URL=
FIELD_ENCRYPTION_KEY=        # Fernet key: from cryptography.fernet import Fernet; Fernet.generate_key()
# Ротация без простоя: новый primary первым, предыдущие ключи после запятой.
FIELD_ENCRYPTION_KEYS=
TAVILY_API_KEY=              # Optional fallback provider for grounded web research
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_GLOBAL_REQUESTS_PER_MINUTE=60
WEB_SEARCH_GLOBAL_MONTHLY_REQUEST_LIMIT=1000
BRAVE_SEARCH_GLOBAL_MONTHLY_REQUEST_LIMIT=800
TAVILY_SEARCH_GLOBAL_MONTHLY_REQUEST_LIMIT=1000
WEB_SEARCH_ATTEMPT_RETENTION_DAYS=730
WEB_SEARCH_STARTED_STALE_SECONDS=7200
WEB_SEARCH_CHECKPOINT_MAX_BYTES=1048576
WEB_SEARCH_WORKFLOW_INPUT_MAX_BYTES=131072
# Эти resource/retry значения можно уменьшать. Код ограничивает их абсолютными
# hard ceilings; увеличение env выше ceiling намеренно не расширяет бюджет.
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_ENDPOINTS_PER_TENANT=20
WEBHOOK_DISPATCH_BATCH_SIZE=100
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_DECODED_IMAGE_PIXELS=16000000
MEDIA_PROVIDER_OUTPUT_MAX_BYTES=26214400
API_BULK_MAX_ITEMS=500
API_REQUEST_MAX_BYTES=12582912
FILE_UPLOAD_MEMORY_MAX_BYTES=1048576
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000
PART_PAGE_MAX_BYTES=2097152
AVITO_API_RESPONSE_MAX_BYTES=5242880
# 100 pages × 100 items cover the supported 10,000-listing feed ceiling.
AVITO_API_MAX_PAGES=100
AVITO_TREE_MAX_DEPTH=12
AVITO_TREE_MAX_NODES=10000
AVITO_TREE_MAX_LEAVES=2000
AVITO_TREE_MAX_TOTAL_CALLS=3000
# Режим служебного lifecycle статусов. legacy сохраняет текущее поведение;
# dual_write включается отдельно согласованным restart всех Django/Celery writers.
AVITO_STATUS_LIFECYCLE_MODE=legacy
# Durable feed-run execution is activated only by a coordinated restart after
# schema and recovery acceptance. Production remains legacy for this release.
MARKETPLACE_FEED_RUN_MODE=legacy
# P5 records desired feed changes only after a separately approved canary.
# Production remains legacy for the schema release.
MARKETPLACE_FEED_INGRESS_MODE=legacy
# Canonical sorted CSV. Production active rollout currently permits one ID.
MARKETPLACE_FEED_CUTOVER_ACCOUNT_IDS=
# P6 remains disabled by default. shadow/canary require a dedicated private,
# versioned bucket, isolated credentials, expected owner and KMS key.
MARKETPLACE_FEED_ARTIFACT_MODE=disabled
MARKETPLACE_FEED_ARTIFACT_BUCKET=
MARKETPLACE_FEED_ARTIFACT_ACCESS_KEY_ID=
MARKETPLACE_FEED_ARTIFACT_SECRET_ACCESS_KEY=
MARKETPLACE_FEED_ARTIFACT_EXPECTED_BUCKET_OWNER=
MARKETPLACE_FEED_ARTIFACT_KMS_KEY_ID=
MARKETPLACE_FEED_ARTIFACT_MAX_BYTES=268435456
MARKETPLACE_FEED_REDIRECT_TTL_SECONDS=120
# P4 ships dark. A real Avito 307 canary and a coordinated restart are required
# before changing either of these production values.
MARKETPLACE_FEED_PROFILE_MIGRATION_ENABLED=false
MARKETPLACE_FEED_PROFILE_SOURCE_SETTLEMENT_SECONDS=3600
MARKETPLACE_FEED_STORAGE_MODE=legacy_public
# Required only for stable_bridge. Values are base64url secrets (at least 32 bytes).
MARKETPLACE_FEED_URL_SIGNING_KEYS=
MARKETPLACE_FEED_URL_SIGNING_PRIMARY_KEY_ID=
# Exact SITE_URL + /marketplace-feeds/v1/feed.xml; defaults to that in development.
MARKETPLACE_FEED_PUBLIC_BASE_URL=
TRUSTED_API_RESPONSE_MAX_BYTES=5242880
AI_PROVIDER_STARTED_STALE_SECONDS=600
AI_PROVIDER_NEVER_STARTED_STALE_SECONDS=300
DATASOURCE_UPLOAD_MAX_BYTES=5242880
DATASOURCE_XLSX_MAX_UNCOMPRESSED_BYTES=26214400
DATASOURCE_XLSX_MAX_ARCHIVE_ENTRIES=1024
DATASOURCE_IMPORT_MAX_ROWS=5000
DATASOURCE_IMPORT_MAX_COLUMNS=128
DATASOURCE_IMPORT_MAX_CELLS=100000
DATASOURCE_XML_MAX_BYTES=8388608
DATASOURCE_HTTP_MAX_BYTES=5242880
DATASOURCE_XML_MAX_NODES=60000
DATASOURCE_XML_MAX_TEXT_CHARS=4194304
DATASOURCE_XML_MAX_ITEMS=5000
DATASOURCE_FETCH_PAGE_MAX_ITEMS=500
AUTH_REFRESH_COOKIE_NAME=map_refresh
PASSWORD_RESET_TIMEOUT=3600
# Число доверенных reverse-proxy hops перед Django (production nginx = 1).
API_NUM_PROXIES=1

# Retention
SOFT_DELETE_RETENTION_DAYS=90
WEBHOOK_AUDIT_RETENTION_DAYS=180
BILLING_AUDIT_RETENTION_DAYS=730
SYNC_LOG_RETENTION_DAYS=90
NOTIFICATION_DELIVERY_RETENTION_DAYS=180
NOTIFICATION_DELIVERY_CLAIM_TIMEOUT_SECONDS=120
PRODUCT_PARSE_RAW_HTML_RETENTION_DAYS=14
PRODUCT_PARSE_JOB_RETENTION_DAYS=180
IMAGE_SEARCH_LOG_RETENTION_DAYS=90
IMAGE_SEARCH_TASK_RETENTION_DAYS=30
PRODUCT_BULK_ACTION_JOB_RETENTION_DAYS=90
MEDIA_PROCESSING_JOB_RETENTION_DAYS=180
BACKGROUND_JOB_RETENTION_DAYS=30
AI_PROVIDER_OPERATION_RETENTION_DAYS=730
RETENTION_PURGE_BATCH_SIZE=1000

# Billing periods
BILLING_TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=7

# Web research
WEB_RESEARCH_AUTO_FALLBACK=true
WEB_RESEARCH_COVERAGE_THRESHOLD=0.65
WEB_RESEARCH_MAX_QUERIES=2
WEB_RESEARCH_RESULTS_PER_QUERY=8
WEB_RESEARCH_TENANT_DAILY_STARTS=30

# Paid image-search starts
IMAGE_SEARCH_BULK_MAX_PRODUCTS=25
IMAGE_SEARCH_TENANT_DAILY_JOBS=100

# External product-parse jobs (all resolved sources combined)
PRODUCT_PARSE_TENANT_DAILY_JOBS=100

# Monitoring. Optional locally; external production error/metric telemetry requires it.
# Empty means Sentry events and map.* metrics are not exported; business paths remain fail-open.
SENTRY_DSN=
