YOOKASSA_ALLOW_TEST_PAYMENTS=false
BILLING_OUTBOX_BASE_DELAY_SECONDS=30
BILLING_OUTBOX_MAX_DELAY_SECONDS=3600
BILLING_OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
BILLING_OUTBOX_BATCH_SIZE=100
BILLING_OUTBOX_MAX_ATTEMPTS=25
BILLING_CHECKOUT_MAX_KEYS_PER_INVOICE=32

# Notifications
SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
BILLING_RETURN_URL_ALLOWED_ORIGINS=https://yourdomain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SENDPULSE_SMTP_LOGIN=
