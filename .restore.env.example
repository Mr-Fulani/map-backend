# Copy this file outside the repository on an isolated recovery host and chmod 600.
# It is intentionally incompatible with .backup.env: restore receives no writer
# credentials, no signing private key and no production database password.

# Canonical production database name used only by the destructive-target guard.
RESTORE_PRODUCTION_DATABASE_NAME=map_db

# A newly-created empty database owned by a dedicated non-superuser role.
RESTORE_DATABASE_URL='postgresql://map_restore:replace-me@restore-db:5432/map_restore_202608'
RESTORE_CONFIRM_DATABASE=map_restore_202608

# Exact encrypted object selected from a verified manifest/freshness check.
RESTORE_OBJECT_KEY='postgres/monthly/2026/08/example.dump.age'

# Offline age identity copied temporarily to the recovery host (absolute path).
RESTORE_AGE_IDENTITY_HOST_FILE='/secure/saas-poster/backup-age-identity.txt'

# Trusted Ed25519 public key from offline escrow, never the S3 copy alone.
RESTORE_SIGNING_PUBLIC_KEY=

# Read-only S3 credentials: GetObject/GetObjectVersion and HeadObject only.
RESTORE_S3_BUCKET=map-backups-prod
RESTORE_S3_PREFIX=postgres
RESTORE_S3_ENDPOINT=https://storage.yandexcloud.net
RESTORE_S3_REGION=ru-central1
RESTORE_S3_ACCESS_KEY=
RESTORE_S3_SECRET_KEY=
# Only for temporary credentials; otherwise leave empty.
RESTORE_S3_SESSION_TOKEN=

RESTORE_COMMAND_TIMEOUT_SECONDS=7200
