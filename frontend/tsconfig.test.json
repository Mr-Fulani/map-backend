{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/lib/api.ts",
    "src/lib/billing-page-loader.ts",
    "src/lib/browser-session-lock.ts",
    "tests/**/*.ts"
  ],
  "exclude": [".next", ".test-dist", "node_modules"]
}
