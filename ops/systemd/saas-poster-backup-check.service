[Unit]
Description=Check freshness of SaaS Poster PostgreSQL backup
RequiresMountsFor=/opt/saas_poster
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/saas_poster
ExecStart=/usr/local/sbin/saas-poster-backup-check
TimeoutStartSec=10m
Restart=on-failure
RestartSec=10m
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
