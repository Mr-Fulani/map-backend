# Отдельный файл только для backup-сервиса. На сервере: chmod 600 .backup.env
# Отдельный DB login: CONNECT + pg_read_all_data, без INSERT/UPDATE/DELETE/DDL.
# Этот URL также задаёт production identity, в которую restore запрещён.
BACKUP_DATABASE_URL=postgresql://map_backup:replace-me@db:5432/map_db

# Выделенный private bucket или отдельный prefix с versioning/lifecycle.
BACKUP_S3_BUCKET=map-backups-prod
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1

# Отдельный service account: Put/Get/List без DeleteObject.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Только для временных credentials, иначе оставить пустым.
BACKUP_S3_SESSION_TOKEN=

# Публичные age recipients через запятую. Private identities на production нет.
BACKUP_AGE_RECIPIENTS=age1replace-with-your-public-recipient

# Ed25519: private подписывает manifest на production, public проверяет restore.
# Public key храните также вне production/S3; оба значения — base64 raw 32 bytes.
BACKUP_SIGNING_PRIVATE_KEY=
BACKUP_SIGNING_PUBLIC_KEY=

# Timeout каждого pg_dump/pg_restore/age subprocess внутри backup-контейнера.
BACKUP_COMMAND_TIMEOUT_SECONDS=3600

# Backup раз в сутки считается просроченным через 26 часов.
BACKUP_MAX_AGE_SECONDS=93600

# Необязательные URL внешнего dead-man monitor.
BACKUP_MONITOR_SUCCESS_URL=
BACKUP_MONITOR_FAILURE_URL=
BACKUP_FRESHNESS_MONITOR_SUCCESS_URL=
BACKUP_FRESHNESS_MONITOR_FAILURE_URL=
