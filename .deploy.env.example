# Host-side deploy settings. Copy to .deploy.env on the production server.
# It must be a regular, root-owned non-symlink file with mode 600
# or 400. Only the keys below are accepted, once each, as literal KEY=value:
# do not use export, quotes, whitespace or shell interpolation.

# Required HTTPS endpoint checked through the current production reverse proxy.
# A domain change must update this value together with nginx.conf, TLS mounts,
# Django/browser origins and the YooKassa return URL allowlist.
PROD_SMOKE_URL=https://dodugir.com/api/v1/ready/

# Optional safeguards.
PROD_MIN_FREE_DISK_MB=16384
PROD_HEALTH_RETRIES=40
PROD_HEALTH_INTERVAL_SECONDS=3
PROD_LOG_TAIL=200
PROD_ROLLBACK_ENABLED=true
# Включает dump, шифрование и upload; превышение блокирует миграции.
PROD_BACKUP_TIMEOUT_SECONDS=7200
# Beat останавливается SIGTERM до закрытия ingress и не наследует долгий worker
# drain. Скрипт отклоняет значения выше 120 секунд.
PROD_BEAT_STOP_TIMEOUT_SECONDS=45
# Максимальное время graceful stop старых web/worker процессов после закрытия
# ingress. Значение должно быть больше самого длинного Celery hard time limit,
# чтобы не оборвать side effect.
PROD_DRAIN_TIMEOUT_SECONDS=3700

# Before the first deploy with redis_broker, drain the legacy queue according to
# docs/PRODUCTION_SECURITY.md and only then change this value to true.
PROD_BROKER_MIGRATION_CONFIRMED=false
