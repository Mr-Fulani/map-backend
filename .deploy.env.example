# Host-side deploy settings. Copy to .deploy.env on the production server and
# restrict access: chmod 600 .deploy.env

# Required HTTPS endpoint checked through the public reverse proxy after deploy.
PROD_SMOKE_URL=https://yourdomain.com/api/v1/ready/

# Optional safeguards.
PROD_MIN_FREE_DISK_MB=2048
PROD_HEALTH_RETRIES=40
PROD_HEALTH_INTERVAL_SECONDS=3
PROD_LOG_TAIL=200
PROD_ROLLBACK_ENABLED=true
# Включает dump, шифрование и upload; превышение блокирует миграции.
PROD_BACKUP_TIMEOUT_SECONDS=7200

# Before the first deploy with redis_broker, drain the legacy queue according to
# docs/PRODUCTION_SECURITY.md and only then change this value to true.
PROD_BROKER_MIGRATION_CONFIRMED=false
